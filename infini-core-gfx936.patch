+#pragma once
+
+#include "ninetoothed.h"
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <dlfcn.h>
+#include <map>
+#include <mutex>
+#include <string>
+
+namespace timestep_nt {
+
+using Launch = NineToothedResult (*)(
+    NineToothedStream,
+    NineToothedTensor,
+    NineToothedTensor,
+    NineToothedTensor,
+    NineToothedTensor);
+
+struct Entry {
+    void *library;
+    Launch launch;
+};
+
+inline infiniStatus_t run(
+    void *output,
+    const void *timestep,
+    size_t count,
+    size_t dim,
+    infiniDtype_t dtype,
+    float max_period,
+    void *stream) {
+
+    if (dim != 16 && dim != 256) {
+        return INFINI_STATUS_NOT_IMPLEMENTED;
+    }
+
+    const char *label = nullptr;
+    switch (dtype) {
+    case INFINI_DTYPE_F16: label = "fp16"; break;
+    case INFINI_DTYPE_BF16: label = "bf16"; break;
+    case INFINI_DTYPE_F32: label = "fp32"; break;
+    default: return INFINI_STATUS_BAD_TENSOR_DTYPE;
+    }
+
+    const char *root = std::getenv("INFINI_TIMESTEP_NT_ROOT");
+    if (!root || !*root) {
+        std::fprintf(stderr, "INFINI_TIMESTEP_NT_ROOT is not set\n");
+        return INFINI_STATUS_INTERNAL_ERROR;
+    }
+
+    std::string directory;
+    std::string name;
+    if (dim == 256 && dtype == INFINI_DTYPE_F32) {
+        directory = "aot_d256_fp32";
+        name = "nt_timestep_aot_d256_fp32";
+    } else {
+        directory = "aot_generic_d" + std::to_string(dim) + "_" + label;
+        name = "nt_timestep_generic_d" + std::to_string(dim) + "_" + label;
+    }
+
+    const std::string path =
+        std::string(root) + "/" + directory + "/" + name + ".so";
+
+    static std::mutex mutex;
+    static std::map<std::string, Entry> libraries;
+    Launch launch = nullptr;
+
+    {
+        std::lock_guard<std::mutex> lock(mutex);
+        auto found = libraries.find(path);
+        if (found == libraries.end()) {
+            void *library = dlopen(path.c_str(), RTLD_NOW | RTLD_LOCAL);
+            if (!library) {
+                std::fprintf(stderr, "NineToothed dlopen: %s\n", dlerror());
+                return INFINI_STATUS_INTERNAL_ERROR;
+            }
+
+            dlerror();
+            auto function = reinterpret_cast<Launch>(
+                dlsym(library, ("launch_" + name).c_str()));
+            const char *error = dlerror();
+            if (error || !function) {
+                std::fprintf(stderr, "NineToothed dlsym: %s\n",
+                             error ? error : "null symbol");
+                dlclose(library);
+                return INFINI_STATUS_INTERNAL_ERROR;
+            }
+
+            found = libraries.emplace(path, Entry{library, function}).first;
+            if (std::getenv("INFINI_TIMESTEP_NT_TRACE")) {
+                std::fprintf(stderr,
+                    "[NineToothed timestep] loaded %s\n", path.c_str());
+            }
+        }
+        launch = found->second.launch;
+    }
+
+    uint64_t input_shape[] = {static_cast<uint64_t>(count)};
+    int64_t input_strides[] = {1};
+
+    uint64_t output_shape[] = {
+        static_cast<uint64_t>(count),
+        static_cast<uint64_t>(dim / 2)};
+    int64_t output_strides[] = {static_cast<int64_t>(dim), 1};
+
+    // 当前九齿 AOT 标量接口使用宿主侧 double 参数缓冲。
+    double period_value = static_cast<double>(max_period);
+
+    NineToothedTensor input{
+        const_cast<void *>(timestep), input_shape, input_strides};
+    NineToothedTensor period{&period_value, nullptr, nullptr};
+    NineToothedTensor cos_output{
+        output, output_shape, output_strides};
+    NineToothedTensor sin_output{
+        static_cast<float *>(output) + dim / 2,
+        output_shape, output_strides};
+
+    const auto result =
+        launch(stream, input, period, cos_output, sin_output);
+
+    if (result != 0) {
+        std::fprintf(stderr, "NineToothed launch failed: %d\n",
+                     static_cast<int>(result));
+        return INFINI_STATUS_INTERNAL_ERROR;
+    }
+    return INFINI_STATUS_SUCCESS;
+}
+
+} // namespace timestep_nt
